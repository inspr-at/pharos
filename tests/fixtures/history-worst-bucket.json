{
  "algorithm": "Keep every gap event when the window holds at most 12. Above that, divide the window into 12 equal buckets and keep the worst event in each bucket. Severity, worse first: down, stale, late, unknown, first, ok. Tie-break: larger gap, then earlier stamp, then lower index. The first sample has no previous gap and is not a mark. Stamps more than 2 seconds ahead of now are excluded. Duplicate stamps collapse before selection. Axis now and start stay at 100. An open gap until now is arrival, not a history mark. Unobserved time is not painted as an on-cadence mark.",
  "dots": 12,
  "clockSkewSecs": 2,
  "cases": [
    {
      "name": "worst-in-bucket",
      "now": 1000000,
      "windowSecs": 600,
      "interval": 60,
      "grace": 15,
      "samples": [999400, 999420, 999820, 999820, 999835, 999845, 999860, 999870, 999880, 999900, 999910, 999930, 999950, 999960, 999980, 999995],
