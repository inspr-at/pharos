          {"stamp": 999860, "level": "ok", "label": "on cadence", "x": 76.7},
          {"stamp": 999900, "level": "ok", "label": "on cadence", "x": 83.3},
          {"stamp": 999950, "level": "ok", "label": "on cadence", "x": 91.7}
        ],
        "hiddenStamps": [999835, 999845, 999870, 999880, 999910, 999930, 999960, 999980, 999995]
      }
    },
